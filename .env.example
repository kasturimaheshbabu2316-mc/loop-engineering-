# EdgeDash Environment Configuration
# Copy this file to .env and fill in your values.
# .env is gitignored and contains secrets — never commit it.

# Google Gemini API key (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_key_here

# Ollama base URL (if using local Ollama instead of Gemini)
# OLLAMA_BASE_URL=http://localhost:11434
